<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>

    <!-- NuGet Package Properties -->
    <PackageId>Glacier.Plot</PackageId>
    <Version>1.2.2</Version>
    <PackageReleaseNotes>v1.2.1: Vector256 SIMD MinMax decimation inner scan and aligned Gpu/Graphics/Polaris/Tensor dependencies.</PackageReleaseNotes>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier High-Performance Ecosystem</Company>
    <Description>Hardware-accelerated 2D data visualization and plotting engine for .NET 10. High-frequency 60/120 FPS rendering on 10M+ points with SIMD LTTB decimation, Glacier.Graphics pure managed rasterization, and direct Glacier.Polaris / Glacier.Tensor interop.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ian-cowley/Glacier.Plot</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.Plot.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>plot;visualization;matplotlib;simd;lttb;graphics;gpu;realtime;streaming;dataframe;polaris;tensor;net10;aot;glacier</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Glacier.Plot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Glacier.Graphics/src/Glacier.Graphics/Glacier.Graphics.csproj" Condition="Exists('../../../Glacier.Graphics/src/Glacier.Graphics/Glacier.Graphics.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Graphics" Condition="!Exists('../../../Glacier.Graphics/src/Glacier.Graphics/Glacier.Graphics.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="../../../Glacier.Polaris/src/Glacier.Polaris/Glacier.Polaris.csproj" Condition="Exists('../../../Glacier.Polaris/src/Glacier.Polaris/Glacier.Polaris.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Polaris" Condition="!Exists('../../../Glacier.Polaris/src/Glacier.Polaris/Glacier.Polaris.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="../../../Glacier.Tensor/src/Glacier.Tensor/Glacier.Tensor.csproj" Condition="Exists('../../../Glacier.Tensor/src/Glacier.Tensor/Glacier.Tensor.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Tensor" Condition="!Exists('../../../Glacier.Tensor/src/Glacier.Tensor/Glacier.Tensor.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="../../../Glacier.Gpu/src/Glacier.Gpu/Glacier.Gpu.csproj" Condition="Exists('../../../Glacier.Gpu/src/Glacier.Gpu/Glacier.Gpu.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Gpu" Condition="!Exists('../../../Glacier.Gpu/src/Glacier.Gpu/Glacier.Gpu.csproj') or '$(UseLocalProjectReferences)' == 'false'" />
  </ItemGroup>
</Project>
